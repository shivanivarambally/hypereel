# ============================================================
#  HypeReel configuration — copy to `.env` and fill in.
#  cp .env.example .env
# ============================================================

# ---- Provider selection --------------------------------------------------
# Which vision provider confirms/scores candidate moments.
#   Options: mock | ollama | gemini | groq | nebius | fireworks
# Use `mock` to run the full pipeline offline with NO API key (demo/tests).
HYPEREEL_VISION_PROVIDER=mock

# Which text/LLM provider writes the summary/report step.
#   Options: mock | ollama | gemini | groq | nebius | fireworks
# NOTE: The course requires >=1 model call via Nebius Token Factory —
#       set this to `nebius` for the graded submission.
HYPEREEL_LLM_PROVIDER=mock

# ---- Local Ollama (no API key; see docs/OLLAMA.md) -----------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=256
OLLAMA_IMAGE_MAX_EDGE=448

# ---- Google Gemini (free tier: https://aistudio.google.com/apikey) -------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Groq (free tier: https://console.groq.com/keys) ---------------------
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---- Nebius Token Factory (course credits provided) ----------------------
# OpenAI-compatible endpoint.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# ---- Fireworks (alternative to Nebius; OpenAI-compatible) ----------------
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p2-90b-vision-instruct

# ---- Runtime tuning (optional; sensible defaults in config.py) -----------
# Frames sampled per candidate window and analysis frame rate.
HYPEREEL_FRAMES_PER_CANDIDATE=3
HYPEREEL_MOTION_SAMPLE_FPS=2
# Directories.
HYPEREEL_DOWNLOAD_DIR=downloads
HYPEREEL_OUTPUT_DIR=output
HYPEREEL_MEMORY_PATH=hypereel_memory.json

# ---- Optional LangSmith graph tracing -----------------------------------
# Uses an explicit callback. Leave global LANGSMITH_TRACING and legacy
# LANGCHAIN_TRACING_V2 unset/false to avoid independent automatic tracing.
HYPEREEL_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hypereel-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional local evidence directory; each evaluation case creates a unique journal.
HYPEREEL_PROVIDER_CHECKPOINT_DIR=

# Zero omits the runtime batch override; smaller values are experimental.
OLLAMA_NUM_BATCH=0

# Opt-in bounded native-video demo adapter; requires gemini-3.8-flash,
# funded budget files, Gemini vision/text providers, and tracing disabled.
GEMINI_NATIVE_VIDEO=false
# Optional form defaults (local source must exist).
HYPEREEL_DEFAULT_RECIPE=
HYPEREEL_DEFAULT_SOURCE=
